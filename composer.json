{
    "name": "olegabr/eth-abi",
    "description": "Solidity ABI types, values and bounds - the read-only base for olegabr/web3.php. No signing, no sending, no transport.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ethereum", "abi", "solidity", "evm", "encoding"],
    "require": {
        "php": ">=8.1",
        "brick/math": "^0.13",
        "olegabr/keccak": "^1.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-keccak",
            "options": {
                "symlink": true,
                "versions": {
                    "olegabr/keccak": "1.2.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../web3.php",
            "options": {
                "symlink": true,
                "versions": {
                    "olegabr/web3.php": "0.3.4"
                }
            }
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "olegabr/web3.php": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "Olegabr\\EthAbi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Olegabr\\EthAbi\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
